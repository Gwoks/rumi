# RUMI environment — copy to `.env` and fill in. NEVER commit `.env`.
#
# Read by `docker compose` (variable interpolation) and by scripts/start.sh
# (exported to the binary). Every variable is optional: the server falls back to
# the default shown here (PRD §5.10) and never crashes on a missing or
# malformed value. On the VPS (systemd) secrets go in /etc/rumi/rumi.env
# instead — see deploy/rumi.service.

# --- network -----------------------------------------------------------------
# Listen port of the bare binary (start.sh, cargo run). Under docker compose it
# is ONLY the published host port; the container always listens on 8080.
APP_PORT=8080
# Bind address: 0.0.0.0 for Docker/LAN, 127.0.0.1 behind a local reverse proxy.
APP_BIND_HOST=0.0.0.0
# Public origin, no trailing slash, e.g. https://rumi-stg.kasibah.com. Used for
# password-reset links, the CSRF Origin allow-list and COOKIE_SECURE=auto.
# Empty = links point at http://localhost:$APP_PORT.
PUBLIC_BASE_URL=
# Secure flag on the session cookie: true | false | auto. auto = Secure when
# PUBLIC_BASE_URL starts with https:// or the request has X-Forwarded-Proto: https.
COOKIE_SECURE=auto

# --- storage -----------------------------------------------------------------
# Leave commented: the right default differs per runtime.
#   docker compose      : /app/data/rumi.db and /app/dist (volume rumi_data)
#   start.sh, cargo run : data/rumi.db and dist, relative to the process cwd
# DATABASE_PATH=data/rumi.db
# STATIC_DIR=dist

# --- admin bootstrap (PRD §5.11.1) -------------------------------------------
# Runs only while no ADMIN user exists. Set BOTH to create the first admin; the
# password needs at least 8 characters (a shorter one is refused with an ERROR
# log and no admin is created). Wrap a value containing `$` in single quotes.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin WhatsApp number for wa.me checkout links. 08…, +62… and separators are
# normalized to 62…; an invalid value falls back to the default with a WARN.
RUMI_ADMIN_WA_PHONE=6281234567890

# --- demo data ---------------------------------------------------------------
# true = add the demo accounts and data (§5.11.4). With ADMIN_EMAIL/PASSWORD
# unset this also creates the PUBLICLY KNOWN admin@rumi.id / rumi-admin-123.
# Local development only — never enable on a reachable server.
# Guard (§5.11.1): when PUBLIC_BASE_URL starts with https:// the server REFUSES
# SEED_DEMO=true (ERROR log, no demo admin, no demo data) unless
# ALLOW_DEMO_SEED_IN_PROD=true. Only set that for a deliberately public demo.
SEED_DEMO=false
ALLOW_DEMO_SEED_IN_PROD=false
# scripts/start.sh only: 1 = run the seed binary even when the DB already exists.
SEED=0

# --- business rules / housekeeping -------------------------------------------
# Auto-cancel window for PENDING_WA orders.
PENDING_ORDER_TTL_HOURS=48
# Session and cookie lifetime.
SESSION_TTL_DAYS=30
# Token-bucket size and refill per minute, per (auth endpoint, client). IPv6
# clients share one bucket per /64 (§5.3.4).
AUTH_RATE_LIMIT_PER_MIN=10
# Checkout (POST /api/orders) bucket per signed-in parent, per minute. <=0 = off.
ORDER_RATE_LIMIT_PER_MIN=10
# Most PENDING_WA orders one parent may hold; more gets
# 409 too_many_pending_orders. 0 = no cap.
MAX_PENDING_ORDERS_PER_PARENT=3
# How often the expiry sweep runs.
SWEEP_INTERVAL_SECONDS=300
# tracing EnvFilter, e.g. `info` or `rumi=debug,tower_http=info`.
RUST_LOG=info
